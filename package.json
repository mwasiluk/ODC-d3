{
  "name": "odc-d3",
  "version": "2.0.0",
  "description": "Open Data Charts for D3",
  "main": "src/index.js",
  "scripts": {
    "build": "npm run clean && npm run build:css && npm run build:js",
    "build:css": "sass --no-source-map --no-error-css src/odc-d3.scss dist/odc-d3.css && sass --no-source-map --no-error-css --style=compressed src/odc-d3.scss dist/odc-d3.min.css",
    "build:js": "rollup -c",
    "clean": "node scripts/clean.js",
    "watch": "node scripts/watch.js",
    "serve": "node scripts/serve.js",
    "test": "npm run test:unit && npm run test:browser",
    "test:setup": "npm ci --prefix test/vendor --no-audit --no-fund",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:browser": "playwright test",
    "test:build": "node scripts/check-build.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwasiluk/ODC-d3.git"
  },
  "keywords": [
    "d3",
    "scatterplot"
  ],
  "author": "Michal Wasiluk",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mwasiluk/ODC-d3/issues"
  },
  "homepage": "https://github.com/mwasiluk/ODC-d3#readme",
  "browserify": {
    "transform": [
      [
        "babelify",
        {
          "global": true,
          "ignore": [
            "/\\/node_modules\\/(?!d3-.+\\/)/"
          ],
          "presets": [
            "@babel/preset-env"
          ],
          "plugins": [
            "transform-class-properties",
            [
              "@babel/plugin-transform-runtime",
              {
                "regenerator": true
              }
            ]
          ]
        }
      ]
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-brush": "^3.0.0",
    "d3-dispatch": "3.0.1",
    "d3-drag": "^3.0.0",
    "d3-ease": "^3.0.1",
    "d3-format": "^3.1.2",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-selection": "3.0.0",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "d3-transition": "^3.0.1",
    "odc-d3-svg-legend": "3.0.0",
    "simple-statistics": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@playwright/test": "1.63.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "acorn": "^8.19.0",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "rollup": "^4.64.2",
    "sass": "^1.106.1"
  }
}
